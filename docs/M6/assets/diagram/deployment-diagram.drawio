        </mxCell>

        <!-- Link 3: Database Protocol -->
        <mxCell id="edge_db" value="&lt;b&gt;TCP / IP&lt;/b&gt;&lt;br&gt;Port 5432 / 5433&lt;br&gt;[PG Protocol]" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#111111;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="node_server" target="node_db">
          <mxGeometry relative="1" as="geometry">
