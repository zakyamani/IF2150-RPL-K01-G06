        <mxCell id="t_users" value="&lt;b&gt;users &amp;amp; merchants&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Akun Pembeli/Penjual, Filter Alergen,&lt;br&gt;Data Gerai, Koordinat Lat/Lng, Rekening&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#000000;fontSize=10;" vertex="1" parent="art_db">
