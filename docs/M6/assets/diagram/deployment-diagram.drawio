          <mxGeometry x="15" y="135" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c_fg_service" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Foreground Alert Service&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;flutter_foreground_task + WebSocket&lt;br&gt;Push Notifikasi Pesanan Baru (No Firebase)&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_apk">
          <mxGeometry x="15" y="205" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="c_native_plugins" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Hardware &amp;amp; UI Plugins&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;mobile_scanner (Kamera QR), qr_flutter,&lt;br&gt;geolocator (GPS), image_picker (Galeri)&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_apk">
          <mxGeometry x="15" y="280" width="220" height="65" as="geometry" />
