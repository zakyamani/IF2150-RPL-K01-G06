        <mxCell id="edge_rest" value="&lt;b&gt;HTTPS / HTTP&lt;/b&gt;&lt;br&gt;Port 443 / 3000&lt;br&gt;[REST JSON]" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#111111;strokeWidth=1.5;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="node_client" target="node_server">
