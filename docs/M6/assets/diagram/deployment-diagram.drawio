        </mxCell>


        <!-- ==================== NODE 3: DATABASE SERVER ==================== -->
        <mxCell id="node_db" value="&amp;lt;&amp;lt;device&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Database Server&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;[Docker Container DBMS]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;spacingTop=10;size=15;" vertex="1" parent="1">
          <mxGeometry x="830" y="75" width="310" height="615" as="geometry" />
