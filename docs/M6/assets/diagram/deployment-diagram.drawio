        </mxCell>

        <mxCell id="t_orders" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Status Pesanan (paid, completed, batal),&lt;br&gt;Token QR Dinamis, Bukti Scan, Payout&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#000000;fontSize=10;" vertex="1" parent="art_db">
          <mxGeometry x="15" y="215" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_complaints" value="&lt;b&gt;complaints &amp;amp; reviews&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Sengketa Refund, Konfirmasi Penjual,&lt;br&gt;Rating Bintang 1-5, &amp;amp; Ulasan Pembeli&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#000000;fontSize=10;" vertex="1" parent="art_db">
          <mxGeometry x="15" y="285" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_audit" value="&lt;b&gt;audit_logs &amp;amp; platform_metrics&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Audit Trail Mutasi Status Transaksi,&lt;br&gt;Akumulasi Metrik Makanan Terselamatkan&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#000000;fontSize=10;" vertex="1" parent="art_db">
          <mxGeometry x="15" y="355" width="220" height="55" as="geometry" />
        </mxCell>


        <!-- ==================== COMMUNICATION EDGES ==================== -->
