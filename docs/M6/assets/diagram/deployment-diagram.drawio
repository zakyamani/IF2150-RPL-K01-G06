  <diagram name="Deployment Diagram SisaRasa" id="SisaRasa-M6-Deployment">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title" value="&lt;b&gt;DEPLOYMENT DIAGRAM (PHYSICAL VIEW) SISTEM SISARASA&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;Arsitektur Fisik Multi-Tier: Android Client (Flutter), Application Server (Node.js/Express), dan Database Server (Docker PostgreSQL 15)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== NODE 1: CLIENT SMARTPHONE ==================== -->
        <mxCell id="node_client" value="&amp;lt;&amp;lt;device&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Client Smartphone&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;[Android Device]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;align=center;spacingTop=10;size=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="75" width="310" height="615" as="geometry" />
        </mxCell>

        <mxCell id="env_android" value="&amp;lt;&amp;lt;execution environment&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Android OS&lt;/b&gt; (v10.0+ / API 29+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#444444;strokeWidth=1;dashed=1;fontColor=#000000;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="node_client">
          <mxGeometry x="15" y="70" width="280" height="530" as="geometry" />
        </mxCell>

        <mxCell id="art_apk" value="&amp;lt;&amp;lt;artifact&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SisaRasaApp.apk&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;(Aplikasi Flutter / Mobile Client)&lt;/font&gt;" style="shape=module;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="env_android">
          <mxGeometry x="15" y="55" width="250" height="460" as="geometry" />
        </mxCell>

        <mxCell id="c_ui" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;UI Presentation&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Katalog Anonim, Filter Alergen,&lt;br&gt;Checkout, Form Penawaran, &amp;amp; Ulasan&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_apk">
