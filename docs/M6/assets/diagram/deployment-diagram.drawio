          <mxGeometry x="15" y="70" width="320" height="410" as="geometry" />
        </mxCell>

        <mxCell id="art_backend" value="&amp;lt;&amp;lt;artifact&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SisaRasaBackend.js&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;(Express.js 4 App / Port 3000)&lt;/font&gt;" style="shape=module;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="env_nodejs">
