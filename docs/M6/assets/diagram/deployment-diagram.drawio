          <mxGeometry x="15" y="70" width="280" height="530" as="geometry" />
        </mxCell>

        <mxCell id="art_db" value="&amp;lt;&amp;lt;database&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;sisarasa_db&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#555555&quot;&gt;(Skema Relasional ACID)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=11;verticalAlign=top;spacingTop=18;" vertex="1" parent="env_postgres">
