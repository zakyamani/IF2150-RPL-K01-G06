        </mxCell>

        <mxCell id="s_router" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;REST API Router &amp;amp; Controllers&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;/api/auth, /api/catalog, /api/orders, /api/offers, /api/scan, /api/complaints, /api/reviews&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="55" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s_ws" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;WebSocket Server Engine (/ws)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;notify.js (Push Real-time Order Paid ke Penjual)&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="115" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s_auth" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Auth &amp;amp; Security Middleware&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;JWT Token Verifier, Hashing bcrypt, CORS, Role Guard&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="170" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s_geo" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Geo-Distance Calculation Engine&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Kalkulasi Haversine di Server (Anonimitas Toko)&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="225" width="260" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s_payment" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Payment Gateway Dummy Engine&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Simulasi QRIS &amp;amp; E-Wallet, Hold Kuota, Auto-Expiry&lt;/font&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="275" width="260" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s_jobs" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt; &lt;b&gt;Background Worker&lt;/b&gt; (Timeout 15m &amp;amp; No-Show)" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;fontColor=#000000;fontSize=10;" vertex="1" parent="art_backend">
          <mxGeometry x="15" y="320" width="260" height="20" as="geometry" />
        </mxCell>

        <!-- Disk Storage -->
        <mxCell id="node_disk" value="&amp;lt;&amp;lt;device&amp;gt;&amp;gt; &lt;b&gt;Local Storage Disk&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#444444;strokeWidth=1;fontColor=#000000;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="node_server">
