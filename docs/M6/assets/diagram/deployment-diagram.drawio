        <mxCell id="art_uploads" value="&amp;lt;&amp;lt;directory&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;uploads/&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Foto Gerai Merchant Terproteksi (Akses via Otorisasi API)&lt;br&gt;Dikelola Pustaka multer&lt;/font&gt;" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="node_disk">
